@page
@using Microsoft.AspNetCore.Http
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "SRE Ingress Upload";
}

<h1>SRE Ingress Upload</h1>
<p>Select a file and upload it to your private ingress area.</p>

<form method="post" enctype="multipart/form-data" action="/api/ingress/upload">
    <div class="mb-3">
        <input type="file" name="file" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary">Upload</button>
</form>

<p class="mt-3">
    After uploading, see your files on the <a href="/Ingressed">Ingressed Files</a> page.
</p>
